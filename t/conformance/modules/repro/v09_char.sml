fun p s = print (s ^ "\n")
fun b true = "T" | b false = "F"
val _ = p (Int.toString (ord #"A") ^ " " ^ str (chr 98) ^ " " ^ Int.toString (Char.ord #"z"))
val _ = p (b (Char.isAlpha #"a") ^ b (Char.isAlpha #"1") ^ b (Char.isDigit #"7") ^ b (Char.isSpace #" ") ^ b (Char.isSpace #"\n") ^ b (Char.isUpper #"Q") ^ b (Char.isLower #"Q") ^ b (Char.isAlphaNum #"_") ^ b (Char.isPunct #"!") ^ b (Char.isHexDigit #"f") ^ b (Char.isPrint #"\t") ^ b (Char.isCntrl #"\t"))
val _ = p (str (Char.toUpper #"a") ^ str (Char.toLower #"Q") ^ str (Char.toUpper #"1"))
val _ = p (Char.toString #"\n" ^ " " ^ Char.toString #"\\" ^ " " ^ Char.toString #"\"" ^ " " ^ Char.toString #"\001" ^ " " ^ Char.toString #"a" ^ " " ^ Char.toString #"\t" ^ " " ^ Char.toString #"\127" ^ " " ^ Char.toString #"\200")
val _ = p (b (Char.contains "abc" #"b") ^ b (Char.contains "abc" #"z") ^ b (Char.notContains "abc" #"z"))
val _ = p (str (Char.succ #"a") ^ str (Char.pred #"b"))
val _ = p ((str (Char.succ (Char.chr 255))) handle Chr => "succ Chr")
val _ = p (case Char.compare (#"a", #"b") of LESS => "LESS" | EQUAL => "EQUAL" | GREATER => "GREATER")
val _ = p (b (#"a" < #"b") ^ b (Char.<= (#"c", #"c")))
val _ = p (case Char.fromString "\\n" of SOME c => Int.toString (ord c) | NONE => "NONE")
val _ = p (case Char.fromString "x" of SOME c => str c | NONE => "NONE")
val _ = p (Int.toString Char.maxOrd ^ " " ^ Int.toString (ord Char.minChar))
val _ = p (Char.toCString #"\n" ^ " " ^ Char.toCString #"\001")
