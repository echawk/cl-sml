fun p s = print (s ^ "\n")
fun b true = "T" | b false = "F"
fun showOpt NONE = "NONE" | showOpt (SOME s) = "SOME " ^ s
val s = "hello world"
val _ = p (Int.toString (String.size s) ^ " " ^ str (String.sub (s, 4)))
val _ = p ((str (String.sub (s, 11))) handle Subscript => "sub Subscript")
val _ = p (String.substring (s, 6, 5))
val _ = p ((String.substring (s, 6, 6)) handle Subscript => "substring Subscript")
val _ = p (String.extract (s, 6, NONE) ^ "|" ^ String.extract (s, 0, SOME 5) ^ "|" ^ String.extract (s, 11, NONE) ^ "|")
val _ = p (String.concat ["a", "b", "c"] ^ " " ^ String.concatWith ", " ["x", "y", "z"] ^ " [" ^ String.concatWith "," [] ^ "]")
val _ = p (String.implode [#"a", #"b"] ^ " " ^ Int.toString (length (String.explode s)))
val _ = p (String.translate (fn #"o" => "0" | c => str c) s)
val _ = p (String.concatWith "|" (String.tokens Char.isSpace "  a bc   d "))
val _ = p (String.concatWith "|" (String.fields (fn c => c = #",") "a,,b,"))
val _ = p (case String.compare ("abc", "abd") of LESS => "LESS" | EQUAL => "EQUAL" | GREATER => "GREATER")
val _ = p (case String.compare ("ab", "a") of LESS => "LESS" | EQUAL => "EQUAL" | GREATER => "GREATER")
val _ = p (b ("abc" < "abd") ^ b ("Z" < "a") ^ b ("" < "a") ^ b (String.<= ("a", "a")))
val _ = p (String.toString "a\nb\t\"q\"\\ \001")
val _ = p (showOpt (String.fromString "a\\nb\\tc"))
val _ = p (showOpt (String.fromString "plain"))
val _ = p (String.map Char.toUpper "shout" ^ " " ^ String.str #"c")
val _ = p (case String.collate (fn (a, b) => Char.compare (b, a)) ("ab", "ac") of LESS => "LESS" | EQUAL => "EQUAL" | GREATER => "GREATER")
val _ = p (String.toCString "a\nb\"")
val _ = p (Int.toString (size (s ^ "!")) ^ " " ^ concat ["p", "q"])
