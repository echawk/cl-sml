fun p s = print (s ^ "\n")
fun showOpt NONE = "NONE" | showOpt (SOME n) = "SOME " ^ Int.toString n
fun ord2s LESS = "LESS" | ord2s EQUAL = "EQUAL" | ord2s GREATER = "GREATER"
val _ = p (Int.toString ~42 ^ " " ^ Int.toString 0 ^ " " ^ Int.toString 123)
val _ = p (showOpt (Int.fromString "123"))
val _ = p (showOpt (Int.fromString "  ~17xyz"))
val _ = p (showOpt (Int.fromString "-5"))
val _ = p (showOpt (Int.fromString "+8"))
val _ = p (showOpt (Int.fromString "abc"))
val _ = p (showOpt (Int.fromString ""))
val _ = p (ord2s (Int.compare (1, 2)) ^ " " ^ ord2s (Int.compare (2, 2)) ^ " " ^ ord2s (Int.compare (3, 2)))
val _ = p (Int.toString (Int.min (3, ~4)) ^ " " ^ Int.toString (Int.max (3, ~4)))
val _ = p (Int.toString (Int.abs ~9) ^ " " ^ Int.toString (Int.sign ~9) ^ " " ^ Int.toString (Int.sign 0) ^ " " ^ Int.toString (Int.sign 5))
val _ = p (Int.toString (~7 div 2) ^ " " ^ Int.toString (~7 mod 2) ^ " " ^ Int.toString (7 div ~2) ^ " " ^ Int.toString (7 mod ~2))
val _ = p (Int.toString (Int.quot (~7, 2)) ^ " " ^ Int.toString (Int.rem (~7, 2)))
val _ = p ((Int.toString (5 mod 0)) handle Div => "mod Div")
val _ = p (Int.fmt StringCvt.HEX 255 ^ " " ^ Int.fmt StringCvt.BIN 5 ^ " " ^ Int.fmt StringCvt.OCT 8 ^ " " ^ Int.fmt StringCvt.DEC ~12)
val _ = p (if Int.sameSign (~1, ~5) then "same" else "diff")
val _ = p (Int.toString (Int.~ 5) ^ " " ^ Int.toString (Int.+ (2, 3)))
val _ = p (if Int.< (1, 2) andalso Int.>= (2, 2) then "rel ok" else "rel bad")
val _ = p (showOpt (StringCvt.scanString (Int.scan StringCvt.HEX) "ff"))
val _ = p (showOpt (StringCvt.scanString (Int.scan StringCvt.DEC) " 12 34"))
