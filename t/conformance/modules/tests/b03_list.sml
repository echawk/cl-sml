fun p s = print (s ^ "\n")
fun ints l = "[" ^ String.concatWith "," (map Int.toString l) ^ "]"
val l = [1, 2, 3, 4, 5]
val _ = p (if List.null [] andalso not (List.null l) then "null ok" else "bad")
val _ = p (Int.toString (List.length l))
val _ = p (ints (l @ [6]))
val _ = p (Int.toString (List.hd l) ^ " " ^ ints (List.tl l))
val _ = p (Int.toString (List.last l))
val _ = p (case List.getItem l of SOME (x, r) => Int.toString x ^ ints r | NONE => "none")
val _ = p (Int.toString (List.nth (l, 2)))
val _ = p ((Int.toString (List.nth (l, 5))) handle Subscript => "nth Subscript")
val _ = p ((Int.toString (List.nth (l, ~1))) handle Subscript => "nth neg Subscript")
val _ = p (ints (List.take (l, 2)) ^ " " ^ ints (List.drop (l, 2)))
val _ = p ((ints (List.take (l, 6))) handle Subscript => "take Subscript")
val _ = p ((ints (List.drop (l, 6))) handle Subscript => "drop Subscript")
val _ = p (ints (List.rev l))
val _ = p (ints (List.concat [[1], [], [2, 3]]))
val _ = p (ints (List.revAppend ([1, 2], [3, 4])))
val _ = List.app (fn x => print (Int.toString x)) l
val _ = p ""
val _ = p (ints (List.map (fn x => x * x) l))
val _ = p (ints (List.mapPartial (fn x => if x mod 2 = 0 then SOME (x * 10) else NONE) l))
val _ = p (case List.find (fn x => x > 3) l of SOME x => Int.toString x | NONE => "none")
val _ = p (case List.find (fn x => x > 9) l of SOME x => Int.toString x | NONE => "none")
val _ = p (ints (List.filter (fn x => x mod 2 = 1) l))
val _ = p (let val (a, b) = List.partition (fn x => x < 3) l in ints a ^ ints b end)
(* foldl/foldr argument order: f (elem, acc) *)
val _ = p (List.foldl (fn (x, acc) => acc ^ Int.toString x) "" l)
val _ = p (List.foldr (fn (x, acc) => acc ^ Int.toString x) "" l)
val _ = p (Int.toString (List.foldl (op -) 0 [1, 2, 3]))
val _ = p (Int.toString (List.foldr (op -) 0 [1, 2, 3]))
val _ = p (if List.exists (fn x => x = 3) l then "exists" else "not exists")
val _ = p (if List.all (fn x => x > 0) l then "all" else "not all")
val _ = p (if List.all (fn x => x > 1) l then "all" else "not all")
val _ = p (ints (List.tabulate (5, fn i => i * i)))
val _ = p ((ints (List.tabulate (~1, fn i => i))) handle Size => "tabulate Size")
val _ = p (case List.collate Int.compare ([1, 2], [1, 3]) of LESS => "LESS" | EQUAL => "EQUAL" | GREATER => "GREATER")
val _ = p (case List.collate Int.compare ([1, 2, 0], [1, 2]) of LESS => "LESS" | EQUAL => "EQUAL" | GREATER => "GREATER")
val _ = p ((Int.toString (List.hd [])) handle List.Empty => "List.Empty")
val _ = p ((Int.toString (List.last [])) handle Empty => "last Empty")
