fun p s = print (s ^ "\n")
fun r2s x = Real.toString x
val _ = p (r2s 0.5 ^ " " ^ r2s ~2.25 ^ " " ^ r2s 1.5E~3)
val _ = p (r2s 3.14159265358979)
val _ = p (r2s 1.0E20 ^ " " ^ r2s 1.0E~5 ^ " " ^ r2s 123456.789 ^ " " ^ r2s 2.5E~10)
val _ = p (r2s (1.0 / 3.0))
val _ = p (Int.toString (Real.floor 2.7) ^ " " ^ Int.toString (Real.floor ~2.7) ^ " " ^ Int.toString (Real.ceil 2.1) ^ " " ^ Int.toString (Real.ceil ~2.1))
val _ = p (Int.toString (Real.round 2.6) ^ " " ^ Int.toString (Real.round 3.4) ^ " " ^ Int.toString (Real.round ~2.6) ^ " " ^ Int.toString (Real.trunc ~2.7))
val _ = p (Int.toString (floor 1.5) ^ " " ^ Int.toString (ceil 1.5) ^ " " ^ Int.toString (round 1.5) ^ " " ^ Int.toString (trunc 1.5))
val _ = p (Int.toString (trunc (Real.fromInt 7 * 1.5)) ^ " " ^ r2s (real 3 + 0.25))
val _ = p (if Real.== (1.5, 1.5) then "==" else "!=")
val _ = p (if Real.!= (1.5, 2.5) then "!=" else "==")
val nan = 0.0 / 0.0
val _ = p (if Real.isNan nan then "nan" else "not nan")
val _ = p (if Real.== (nan, nan) then "nan==nan" else "nan<>nan")
val _ = p (if Real.isFinite (1.0 / 0.0) then "finite" else "infinite")
val _ = p (r2s (1.0 / 0.0) ^ " " ^ r2s (~1.0 / 0.0))
val _ = p (Real.fmt (StringCvt.FIX (SOME 4)) (Math.sqrt 2.0))
val _ = p (Real.fmt (StringCvt.FIX (SOME 4)) (Math.sin 1.0))
val _ = p (Real.fmt (StringCvt.FIX (SOME 4)) (Math.exp 1.0))
val _ = p (Real.fmt (StringCvt.FIX (SOME 4)) (Math.ln 10.0))
val _ = p (Real.fmt (StringCvt.FIX (SOME 2)) Math.pi)
val _ = p (Real.fmt (StringCvt.SCI (SOME 3)) 12345.678)
val _ = p (Real.fmt (StringCvt.FIX (SOME 0)) 2.5)
val _ = p (case Real.compare (1.0, 2.0) of LESS => "LESS" | EQUAL => "EQUAL" | GREATER => "GREATER")
val _ = p (r2s (Real.max (1.5, 2.5)) ^ " " ^ r2s (Real.min (1.5, 2.5)) ^ " " ^ r2s (Real.abs ~3.5))
val _ = p (case Real.fromString "3.25" of SOME x => r2s x | NONE => "NONE")
val _ = p (case Real.fromString "abc" of SOME x => r2s x | NONE => "NONE")
val _ = p ((Int.toString (Real.floor nan)) handle Domain => "floor nan Domain" | Overflow => "floor nan Overflow")
val _ = p ((Int.toString (Real.round (1.0 / 0.0))) handle Overflow => "round inf Overflow")
val _ = p (r2s (2.0 * 3.5 - 1.5) ^ " " ^ r2s (7.0 / 2.0))
val _ = p (Int.toString (Real.sign ~2.0) ^ " " ^ Int.toString (trunc (Real.realFloor 2.5)))
