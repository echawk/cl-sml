fun p s = print (s ^ "\n")
val _ = p (OS.Path.joinDirFile {dir = "a/b", file = "c.txt"})
val {dir, file} = OS.Path.splitDirFile "a/b/c.txt"
val _ = p (dir ^ " " ^ file)
val _ = p (OS.Path.base "foo.tar.gz" ^ " " ^ (case OS.Path.ext "foo.tar.gz" of SOME e => e | NONE => "NONE"))
val _ = p (case OS.Path.ext "noext" of SOME e => e | NONE => "NONE")
val _ = p (if OS.Path.isAbsolute "/x/y" andalso OS.Path.isRelative "x/y" then "abs/rel ok" else "bad")
val _ = p (OS.Path.concat ("a/b", "c/d"))
val _ = p (OS.Path.mkCanonical "a/./b/../c")
val _ = p (OS.Path.dir "a/b/c" ^ " " ^ OS.Path.file "a/b/c")
val _ = p (OS.Path.joinBaseExt {base = "x", ext = SOME "sml"})
val _ = p (String.concatWith "|" (#arcs (OS.Path.fromString "/usr/lib/x")))
val _ = p (if OS.FileSys.isDir "." then "dot is dir" else "dot not dir")
val _ = p (if size (OS.FileSys.getDir ()) > 0 then "getDir ok" else "getDir empty")
val _ = p (if size (CommandLine.name ()) > 0 then "name ok" else "name empty")
val _ = p (if OS.Process.isSuccess OS.Process.success then "success" else "failure")
