fun p s = print (s ^ "\n")
fun showOpt NONE = "NONE" | showOpt (SOME n) = "SOME " ^ Int.toString n
val _ = p (Int.toString (getOpt (NONE, 7)) ^ " " ^ Int.toString (getOpt (SOME 3, 7)))
val _ = p (if isSome (SOME 1) andalso not (isSome NONE) then "isSome ok" else "bad")
val _ = p (Int.toString (valOf (SOME 9)))
val _ = p ((Int.toString (Option.valOf NONE)) handle Option.Option => "Option raised")
val _ = p (showOpt (Option.map (fn x => x * 2) (SOME 21)))
val _ = p (showOpt (Option.map (fn x => x * 2) NONE))
val _ = p (showOpt (Option.join (SOME (SOME 4))))
val _ = p (showOpt (Option.filter (fn x => x > 5) 3))
val _ = p (showOpt (Option.filter (fn x => x > 5) 8))
val _ = p (showOpt (Option.mapPartial (fn x => if x > 0 then SOME (x - 1) else NONE) (SOME 5)))
val _ = p (showOpt (Option.compose (fn x => x + 1, fn x => if x > 0 then SOME x else NONE) 4))
val _ = Option.app (fn x => p ("app " ^ Int.toString x)) (SOME 1)
val _ = p (Int.toString (Option.getOpt (NONE, 2)))
