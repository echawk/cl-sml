(* @basis *)
fun p s = print (s ^ "\n")
val _ = p ((str (chr 300)) handle Chr => "Chr")
val _ = p ((str (chr ~1)) handle Chr => "Chr")
val _ = p (str (chr 65))
val _ = p ((str (String.sub ("abc", 5))) handle Subscript => "Subscript")
val _ = p ((str (String.sub ("abc", ~1))) handle Subscript => "Subscript")
val _ = p ((String.substring ("abc", 1, 5)) handle Subscript => "Subscript")
val _ = p ((Int.toString (List.nth ([1], 5))) handle Subscript => "Subscript")
val _ = p ((Int.toString (hd [])) handle Empty => "Empty")
val _ = p ((Int.toString (valOf NONE)) handle Option => "Option")
val _ = p ((Int.toString (Vector.sub (Vector.fromList [1], 1))) handle Subscript => "Subscript")
val _ = p ((Int.toString (Array.length (Array.array (~1, 0)))) handle Size => "Size")
val _ = p ((Int.toString (Vector.length (Vector.tabulate (~1, fn i => i)))) handle Size => "Size")
val _ = p (General.exnName Div ^ " " ^ exnName (Fail "x"))
