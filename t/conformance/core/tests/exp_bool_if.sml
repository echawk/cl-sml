fun t s = (print (s ^ " "); true)
fun f s = (print (s ^ " "); false)
fun b x = print ((if x then "true" else "false") ^ "\n")
val _ = b (f "a" andalso t "b")
val _ = b (t "c" orelse t "d")
val _ = b (t "e" andalso f "f" orelse t "g")
val _ = b (f "h" orelse f "i" andalso t "j")
val _ = b (if t "k" then f "l" else t "m")
val _ = print (if 1 < 2 then if 2 < 1 then "x\n" else "y\n" else "z\n")
val _ = b (not (true andalso false))
