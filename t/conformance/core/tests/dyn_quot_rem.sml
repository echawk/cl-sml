(* @basis *)
fun p n = print (Int.toString n ^ "\n")
val _ = p (Int.quot (7, 2))
val _ = p (Int.rem (7, 2))
val _ = p (Int.quot (~7, 2))
val _ = p (Int.rem (~7, 2))
val _ = p (Int.quot (7, ~2))
val _ = p (Int.rem (7, ~2))
val _ = print ((Int.toString (Int.quot (1, 0))) handle Div => "Div\n")
val _ = print ((Int.toString (Int.rem (1, 0))) handle Div => "Div\n")
