fun p n = print (Int.toString n ^ "\n")
fun b x = print ((if x then "true" else "false") ^ "\n")
val _ = p (2 * 3 + 4)
val _ = p (2 + 3 * 4)
val _ = p (10 - 3 - 2)
val _ = p (100 div 10 div 2)
val _ = p (17 mod 5 * 2)
val _ = b ([1] = 1 :: nil)
val _ = b (1 :: [2] @ [3] = [1, 2, 3])
val _ = b ("a" ^ "b" = "ab")
val _ = b (1 < 2 = true)
val _ = b (1 + 1 = 2 andalso 2 < 3 orelse false)
val r = ref 0
val _ = r := 3 + 4 * 2
val _ = p (!r)
val _ = p (((fn x => x + 1) o (fn x => x * 2)) 5)
val _ = p (~3 + 5)
val _ = p (length (1 :: 2 :: []) + 1)
val _ = p (1 before print "before\n")
val _ = b (not (1 = 2))
val _ = p (hd [4, 5] + hd (tl [4, 5]))
