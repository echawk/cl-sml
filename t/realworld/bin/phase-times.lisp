;;; (rw-phases "file.sml" checked-p): time each compilation phase separately.
(defun rw-phases (file checked)
  (let* ((cl-sml:*sml-type-checker* (and checked cl-sml::*hamlet-type-checker*))
         (cl-sml::*sml-package* (cl-sml::ensure-sml-package "SML.RW"))
         (src (uiop:read-file-string file))
         (t0 (get-internal-real-time)) facts ast form)
    (flet ((lap (what) (format t "~&~A: ~,2Fs~%" what (/ (- (get-internal-real-time) t0) internal-time-units-per-second))
             (setf t0 (get-internal-real-time))))
      (setf facts (cl-sml::static-facts-from-check
                   (multiple-value-list (cl-sml::type-check-sml-string src :filename file))))
      (lap "check")
      (cl-sml::with-sml-static-facts (facts)
        (setf ast (cl-sml:parse-sml-program src :source-name file))
        (lap "parse")
        (setf form (cl-sml::compile-with-hoisted-sml-forms (lambda () (cl-sml::compile-program ast)) :identity src))
        (lap "ast->lisp"))
      (with-open-file (s (merge-pathnames "phase.lisp" (uiop:temporary-directory)) :direction :output :if-exists :supersede)
        (cl-sml::write-sml-lisp-artifact form (cl-sml::ensure-sml-package "SML.RW") (pathname file) s))
      (lap "print-lisp")
      (let ((*error-output* (make-broadcast-stream)) (*standard-output* (make-broadcast-stream)))
        (handler-bind ((warning #'muffle-warning))
          (compile-file (merge-pathnames "phase.lisp" (uiop:temporary-directory)))))
      (lap "sbcl compile-file")
      (let ((*standard-output* (make-broadcast-stream)))
        (load (merge-pathnames "phase.fasl" (uiop:temporary-directory))))
      (lap "load fasl (runs top level)"))))
