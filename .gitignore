# ASDF's FASL cache (test.sh and the corpus runners default XDG_CACHE_HOME here)
/.cache/
# The executable build-hamlet saves
/cl-hamlet
# Conformance runners' output
/t/conformance/core/build/
/t/conformance/modules/.cache/
/t/conformance/modules/results/
/t/conformance/modules/tmp/
# The real-world harness lists $R/work (a link to $RW_STATE/work when set)
/t/realworld/work
